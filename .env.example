# ---------------------------------------------------------------------------------------------
# Website (PWA) and mobile app configuration — PUBLIC values only.
# Copy to `.env` for local development. For Cloudflare Pages, add the same variables under
# Settings → Variables and secrets (Production and Preview) — they are read at build time.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle and visible to anyone.
# (This project builds with Expo, so the prefix is EXPO_PUBLIC_ rather than VITE_; the rule is the same.)
# NEVER put GEMINI_API_KEY, GOOGLE_MAPS_API_KEY or the Supabase service-role key here —
# they belong in Supabase Edge Function secrets (supabase/.env.example).
#
# Leave both empty to run without accounts (data stays in the browser / on the device; no AI assistant).
# ---------------------------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Public by design; data access is restricted by Row Level Security.
# (The legacy name EXPO_PUBLIC_SUPABASE_ANON_KEY is still accepted.)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
