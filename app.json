{
  "expo": {
    "name": "EcoMove AI",
    "slug": "ecomove-ai",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ecomoveai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ecomoveai.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ecomoveai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#DDEFE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./public/icons/favicon-48.png",
      "name": "EcoMove AI",
      "shortName": "EcoMove",
      "themeColor": "#1F7A4D",
      "backgroundColor": "#F5F7F4",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1512"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EcoMove AI uses your location while the app is open to detect trips you take, estimate their distance and calculate their carbon footprint. Trip detection runs on your device.",
          "locationAlwaysAndWhenInUsePermission": "If you turn on automatic trip detection, EcoMove AI uses your location in the background to notice when a journey starts and ends, so trips are recorded even when the app is closed. You can pause or stop this at any time in the app.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F7A4D"
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
