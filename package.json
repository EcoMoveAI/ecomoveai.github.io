{
  "name": "ecomove-ai",
  "main": "index.ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "node scripts/copy-web-vendor.mjs && expo start --web",
    "build:web": "node scripts/build-web.mjs",
    "preview:web": "node scripts/serve-dist.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "test": "jest && npm run test:db",
    "test:unit": "jest",
    "test:db": "node --test --test-reporter=spec __tests__/db/rls.test.mts",
    "test:watch": "jest --watch",
    "gen:factor-seed": "node scripts/gen-factor-seed.mts",
    "gen:pwa-icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/gen-pwa-icons.ps1",
    "doctor": "expo-doctor",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "sql.js": "^1.14.2",
    "typescript": "~6.0.3",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.149.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts",
      "<rootDir>/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@core/(.*)$": "<rootDir>/supabase/functions/_shared/core/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testTimeout": 20000
  },
  "engines": {
    "node": ">=20.19"
  }
}
