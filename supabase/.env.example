# ---------------------------------------------------------------------------------------------
# Supabase Edge Function secrets (server-side only). Copy to `supabase/.env` and run:
#   npx supabase secrets set --env-file supabase/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# NEVER put any of these values in the root .env / EXPO_PUBLIC_* variables: those are bundled into the
# public website and can be read by anyone.
# ---------------------------------------------------------------------------------------------

# LLM provider for the AI assistant: gemini (default) | anthropic
LLM_PROVIDER=gemini

# Google Gemini API key from https://aistudio.google.com/apikey. Required for the AI assistant.
# Free tier: limited requests per minute/day, and Google may use submitted content to improve its
# products (see docs/PRIVACY.md). Without a key the rest of the app works; the assistant says it is unavailable.
GEMINI_API_KEY=
# Optional: model override and comma-separated fallbacks tried when the model is unavailable or out of quota
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Alternative provider (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium

# Google Maps Platform key with the Routes API enabled. Optional: without it, route options are
# reported as unavailable and users enter distances manually.
GOOGLE_MAPS_API_KEY=

# Max assistant requests per user per hour
AGENT_HOURLY_LIMIT=30

# Browser origins allowed to call the functions (comma-separated). Recommended in production, e.g.
# https://ecomove-ai.pages.dev,http://localhost:8081 — leave empty to allow any origin.
ALLOWED_ORIGINS=
