// Cloudflare static-assets deployment of the EcoMove PWA (Cloudflare's current home for Pages-style sites).
// Build first with `npm run build:web` (adds the service worker and verifies the output), then `wrangler deploy`
// — or simply `npm run deploy`. dist/_headers is applied; unknown paths fall back to index.html (SPA routing).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecomove-ai",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
